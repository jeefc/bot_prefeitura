# Copie este arquivo para ".env" e preencha. O ".env" NUNCA deve ser commitado.

# Token gerado pelo @BotFather (ex: 123456789:ABCdefGhIJKlmNoPQRstuvWXyz)
TELEGRAM_BOT_TOKEN=cole_o_token_aqui

# ID do chat que receberá alertas e poderá dar comandos (ex: 123456789)
TELEGRAM_CHAT_ID=cole_o_chat_id_aqui

# Nome completo a ser monitorado nos boletins (fica só no seu .env / secret)
NOME_BUSCA=Seu Nome Completo
